{
  "$schema": "node_modules/wrangler/config-schema.json",

  // The Worker this repository deploys to. The name must keep matching the
  // existing production Worker, otherwise a deploy creates a second one and
  // the live domain keeps serving the old build.
  "name": "openly",
  "main": ".open-next/worker.js",

  // Kept at or below the workerd release the pinned wrangler ships, so the
  // build does not warn about a date the runtime does not know yet. Raising it
  // is safe and deliberate; leaving it far in the past is what made `fetch`
  // reject the `cache` option and produced the Apple catalog 502s.
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Runtime variables. Only variables without the NEXT_PUBLIC_ prefix belong
  // here: Next.js inlines NEXT_PUBLIC_* into the bundle at build time, so
  // NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_SUPABASE_URL and
  // NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY have to be set as *build* variables on
  // the Cloudflare project -- setting them here would do nothing at all.
  //
  // AUTH_EMAIL_MODE is read at request time (app/api/auth/otp/request and
  // lib/authCapabilities), carries no secret, and matches the value pinned in
  // vercel.json, so it lives in the repository instead of the dashboard.
  "vars": {
    "AUTH_EMAIL_MODE": "otp"
  }

  // No R2 incremental cache, no images binding and no self-reference service:
  // every route in this app is `force-dynamic`, there is no ISR, no `use cache`
  // and no next/image. Declaring bindings for resources that do not exist would
  // only make the deploy fail.
}
