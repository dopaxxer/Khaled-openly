# Production build variables.
#
# Next.js inlines NEXT_PUBLIC_* at build time, so they have to exist when the
# bundle is produced -- a runtime variable never reaches this code. They lived
# in vercel.json until Vercel was dropped; the Cloudflare build had no
# equivalent, which is how the first successful Worker deploy went out with an
# empty Supabase URL and answered every request with Internal Server Error.
#
# None of these are secret. The publishable key and the project URL are sent to
# every browser on every request. The secret is the service_role key, which is
# never used here and must never appear in a NEXT_PUBLIC_ variable.
#
# lib/supabaseEnv.js still refuses to guess: it carries no hardcoded fallback
# and throws when these are absent. Naming the project here is the opposite of
# that failure -- it pins the deployment to the database this account owns,
# rather than letting an unset variable resolve to somebody else's.
NEXT_PUBLIC_SITE_URL=https://openly.ink
NEXT_PUBLIC_SUPABASE_URL=https://egwhybfcnlzijomgeebj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_pZN6kVnQGZK3QwNdVmG7Ww_vqYqvO_X
